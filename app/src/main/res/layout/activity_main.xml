<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.phantomfloor.engine.PhantomSurfaceView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/castPad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0B10"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="#88FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/hint_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/doneButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="@string/done"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/controlPanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/panel_bg"
        android:fadeScrollbars="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_title"
                android:textColor="#7CFF9B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                style="@style/PanelSection"
                android:text="@string/section_scene" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/seasonGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/sceneGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <LinearLayout
                android:id="@+id/paramContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/PanelSection"
                android:text="@string/section_projection" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/castButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cast" />

            <LinearLayout
                android:id="@+id/projectionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keystoneButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/edit_keystone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetKeystoneButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/reset_keystone" />
            </LinearLayout>

            <TextView
                style="@style/PanelSection"
                android:text="@string/section_interaction" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/trackingSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/camera_tracking" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/trackingModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/modeFeetChip"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_feet" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/modeBodiesChip"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_bodies" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calibrateButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calibrate_camera" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/debugSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_tracking" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/touchSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/touch_as_person" />

            <TextView
                style="@style/PanelSection"
                android:text="@string/section_audio" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/audioSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/audio_reactive" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/soundSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sound_effects" />

            <LinearLayout
                android:id="@+id/audioContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/updateButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/supportButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/support" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:textColor="#66FFFFFF"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hide_panel" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
